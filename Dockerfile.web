FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY Assistech.sln ./
COPY src/Assistech.Web/Assistech.Web.csproj src/Assistech.Web/
COPY src/Assistech.Data/Assistech.Data.csproj src/Assistech.Data/
COPY src/Assistech.Shared/Assistech.Shared.csproj src/Assistech.Shared/
RUN dotnet restore src/Assistech.Web/Assistech.Web.csproj

COPY src/ src/
RUN dotnet publish src/Assistech.Web/Assistech.Web.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .

ENV ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_gcServer=1
EXPOSE 8080
ENTRYPOINT ["dotnet", "Assistech.Web.dll"]
