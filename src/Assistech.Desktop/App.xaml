<Application x:Class="Assistech.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Assistech.Desktop"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>

            <!-- paleta neutra: a cor da loja e injetada em runtime -->
            <Color x:Key="CorPrimaria">#0D6EFD</Color>
            <SolidColorBrush x:Key="BrushPrimaria" Color="{StaticResource CorPrimaria}" />
            <SolidColorBrush x:Key="BrushPrimariaEscura" Color="#0A58CA" />
            <SolidColorBrush x:Key="BrushPrimariaClara" Color="#E7F1FF" />

            <SolidColorBrush x:Key="BrushFundo" Color="#F4F6F9" />
            <SolidColorBrush x:Key="BrushSuperficie" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BrushBorda" Color="#E3E8EF" />
            <SolidColorBrush x:Key="BrushTexto" Color="#1F2933" />
            <SolidColorBrush x:Key="BrushTextoFraco" Color="#6B7A8D" />
            <SolidColorBrush x:Key="BrushLateral" Color="#1B2430" />
            <SolidColorBrush x:Key="BrushLateralAtivo" Color="#24303F" />
            <SolidColorBrush x:Key="BrushLateralTexto" Color="#C7D1DD" />
            <SolidColorBrush x:Key="BrushPerigo" Color="#DC3545" />
            <SolidColorBrush x:Key="BrushSucesso" Color="#198754" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource BrushTexto}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style x:Key="Titulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="#0F172A" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <Style x:Key="Rotulo" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{StaticResource BrushTextoFraco}" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="White" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="7,5" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontFamily" Value="Segoe UI" />
            </Style>

            <Style x:Key="Botao" TargetType="Button">
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="{StaticResource BrushPrimaria}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.88" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#334155" />
                <Setter Property="BorderBrush" Value="#CBD5E1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="#F1F5F9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="BotaoPerigo" TargetType="Button" BasedOn="{StaticResource Botao}">
                <Setter Property="Background" Value="{StaticResource BrushPerigo}" />
            </Style>

            <Style x:Key="ItemMenu" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource BrushLateralTexto}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,11" />
                <Setter Property="Margin" Value="8,2" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Fundo" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="#22303F" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Fundo" Property="Background" Value="{StaticResource BrushPrimaria}" />
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
