<UserControl x:Class="Assistech.Desktop.Views.ClientesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Assistech.Desktop.Converters"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:BooleanoVisibilidadeConverter x:Key="BoolVis" />

        <Style x:Key="Celula" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#1F2933" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" Text="{Binding Busca, UpdateSourceTrigger=PropertyChanged, Delay=350}"
                     Padding="10,7" VerticalContentAlignment="Center" />

            <Button Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Botao}" Height="32" Padding="18,0"
                    Content="Novo cliente" Click="NovoClienteClicado" />
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                CornerRadius="8" ClipToBounds="True">
            <Grid>
                <DataGrid x:Name="Grid" ItemsSource="{Binding Clientes}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F5" BorderThickness="0" Background="White"
                          RowHeaderWidth="0" ColumnHeaderHeight="38" CanUserAddRows="False"
                          SelectionMode="Single" FontSize="12.5" CellStyle="{StaticResource Celula}"
                          SelectedItem="{Binding ClienteSelecionado, Mode=TwoWay}"
                          MouseDoubleClick="LinhaDuploClique">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="1.6*" />
                        <DataGridTextColumn Header="Documento" Binding="{Binding Documento}" Width="1*" />
                        <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="1*" />
                        <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="1.4*" />
                        <DataGridTextColumn Header="Equip." Binding="{Binding Equipamentos}" Width="60" />
                        <DataGridTextColumn Header="OS" Binding="{Binding Ordens}" Width="50" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="320"
                            Visibility="{Binding TemClientes, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <TextBlock Text="Nenhum cliente cadastrado" FontSize="15" FontWeight="SemiBold"
                               Foreground="#334155" HorizontalAlignment="Center" />
                    <TextBlock Text="Cadastre o cliente e vincule os equipamentos que recebe para manutencao."
                               FontSize="12" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,6,0,0" />
                    <Button Content="Cadastrar cliente" Style="{StaticResource Botao}" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="16,7" Click="NovoClienteClicado" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="{Binding Resumo}" VerticalAlignment="Center" FontSize="12" Foreground="#6B7A8D"
                       HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Anterior" Style="{StaticResource BotaoSecundario}" Padding="12,6"
                        Click="PaginaAnteriorClicado" />
                <Button Content="Proxima" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0"
                        Click="ProximaPaginaClicado" />
                <Button Content="Abrir" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0"
                        Click="AbrirClicado" />
                <Button Content="Excluir" Style="{StaticResource BotaoSecundario}" Padding="12,6" Margin="8,0,0,0"
                        Click="ExcluirClicado" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
