<UserControl x:Class="Assistech.Desktop.Views.LojaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Assistech.Desktop.Converters"
             FontFamily="Segoe UI">
    <UserControl.Resources>
        <conv:BooleanoVisibilidadeConverter x:Key="BoolVis" />
        <conv:NaoVazioVisibilidadeConverter x:Key="NaoVazioVis" />
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Style="{StaticResource Titulo}" Text="Personalize sua loja" />
            <TextBlock Foreground="#6B7A8D" FontSize="12.5"
                       Text="Estes dados aparecem no sistema, no termo de ordem de servico e nos documentos da loja." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- logo -->
            <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                    CornerRadius="8" Padding="20" Margin="0,0,18,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Rotulo}" Text="LOGO DA LOJA" />

                    <Border Height="150" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Margin="0,6,0,0">
                        <Grid>
                            <Image Source="{Binding Logo}" Stretch="Uniform" Margin="12"
                                   Visibility="{Binding Logo, Converter={StaticResource BoolVis}}" />
                            <TextBlock Text="Sem logo" Foreground="#94A3B8" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding Logo, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="PNG ou JPG, ate 2 MB. Aparece no topo do termo impresso."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap" Margin="0,8,0,0" />

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Enviar logo" Style="{StaticResource Botao}" Padding="14,7"
                                Click="EnviarLogoClicado" />
                        <Button Content="Remover" Style="{StaticResource BotaoSecundario}" Padding="14,7"
                                Margin="8,0,0,0" Click="RemoverLogoClicado"
                                IsEnabled="{Binding TemLogo}" />
                    </StackPanel>

                    <Separator Margin="0,20,0,16" Background="#EEF1F5" />

                    <TextBlock Style="{StaticResource Rotulo}" Text="COR PRIMARIA" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="36" Height="30" CornerRadius="6"
                                Background="{StaticResource BrushPrimaria}" Margin="0,0,10,0" />
                        <TextBox Grid.Column="1" Text="{Binding CorPrimaria, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center" Padding="8,5" />
                    </Grid>
                    <TextBlock Text="Use o formato #RRGGBB, por exemplo #0D6EFD."
                               FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- dados -->
            <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                    CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Style="{StaticResource Rotulo}" Text="DADOS DA EMPRESA" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="NOME / RAZAO SOCIAL" />
                            <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="CNPJ / CPF" />
                            <TextBox Text="{Binding Documento, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="TELEFONE" />
                            <TextBox Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="WHATSAPP" />
                            <TextBox Text="{Binding Whatsapp, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="E-MAIL" />
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Rotulo}" Text="ENDERECO" />
                            <TextBox Text="{Binding Endereco, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <Border Background="#F0FDF4" CornerRadius="6" Padding="12,8" Margin="0,4,0,0"
                            Visibility="{Binding Mensagem, Converter={StaticResource NaoVazioVis}}">
                        <TextBlock Text="{Binding Mensagem}" Foreground="#166534" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <Button Content="Salvar alteracoes" Style="{StaticResource Botao}" HorizontalAlignment="Right"
                            Margin="0,18,0,0" Padding="20,9" Click="SalvarClicado" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
