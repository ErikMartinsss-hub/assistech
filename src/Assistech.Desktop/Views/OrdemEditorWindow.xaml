<Window x:Class="Assistech.Desktop.Views.OrdemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Assistech.Desktop.Converters"
        Title="{Binding Titulo}"
        Height="860" Width="1120" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource BrushFundo}">
    <Window.Resources>
        <conv:BooleanoVisibilidadeConverter x:Key="BoolVis" />
        <conv:NaoVazioVisibilidadeConverter x:Key="NaoVazioVis" />
    </Window.Resources>

    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- cabecalho -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Titulo}" Style="{StaticResource Titulo}" />
                <TextBlock Text="{Binding Resumo}" Foreground="#6B7A8D" FontSize="12" />
            </StackPanel>

            <Button Grid.Column="1" Content="Fechar" Style="{StaticResource BotaoSecundario}" Padding="16,8"
                    VerticalAlignment="Top" Click="FecharClicado" IsCancel="True" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <!-- coluna esquerda: cliente, equipamento, status -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- cliente -->
                    <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                            CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rotulo}" Text="CLIENTE" />

                            <Grid>
                                <TextBox Text="{Binding ClienteBusca, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         Padding="9,6" Visibility="{Binding ClienteSelecionado, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                                <Border Background="#F1F5F9" CornerRadius="6" Padding="10,7"
                                        Visibility="{Binding ClienteSelecionado, Converter={StaticResource BoolVis}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ClienteSelecionado.Nome}" FontWeight="SemiBold"
                                                       FontSize="13" />
                                            <TextBlock Text="{Binding ClienteSelecionado.Telefone}" FontSize="11.5"
                                                       Foreground="#6B7A8D" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Trocar" FontSize="11" Padding="10,3"
                                                Style="{StaticResource BotaoSecundario}" Click="LimparClienteClicado" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                                    CornerRadius="6" Padding="6" Margin="0,8,0,0"
                                    Visibility="{Binding ResultadosClientes, Converter={StaticResource NaoVazioVis}}"
                                    MaxHeight="190">
                                <ListBox ItemsSource="{Binding ResultadosClientes}" BorderThickness="0"
                                         Background="Transparent" MaxHeight="178" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="6,4" Cursor="Hand" MouseLeftButtonUp="SelecionarCliente">
                                                <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock FontSize="11" Foreground="#6B7A8D">
                                                    <Run Text="{Binding Telefone, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- equipamento -->
                    <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rotulo}" Text="EQUIPAMENTO" />
                            <TextBlock Text="Selecione o aparelho que entrou para manutencao."
                                       FontSize="11" Foreground="#94A3B8" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Equipamentos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderThickness="1" CornerRadius="6" Padding="10,7"
                                                Margin="0,0,8,8" MinWidth="190"
                                                MouseLeftButtonUp="SelecionarEquipamentoClicado">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="#E2E8F0" />
                                                    <Setter Property="Background" Value="#F8FAFC" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimaria}" />
                                                            <Setter Property="Background" Value="{StaticResource BrushPrimariaClara}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Titulo}" FontSize="12" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Nenhum equipamento cadastrado para este cliente."
                                       FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0"
                                       Visibility="{Binding Equipamentos, Converter={StaticResource NaoVazioVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Border>

                    <!-- status e resumo -->
                    <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rotulo}" Text="STATUS E PRAZO" />

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="STATUS" />
                                    <ComboBox ItemsSource="{Binding StatusDisponiveis}" DisplayMemberPath="Descricao"
                                              SelectedValuePath="Valor" SelectedValue="{Binding Status}" Padding="8,5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="PREVISAO DE ENTREGA" />
                                    <TextBox Text="{Binding Previsao}" Padding="8,5" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource Rotulo}" Text="TIPO DE SERVICO" Margin="0,12,0,0" />
                            <TextBox Text="{Binding TipoServico, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />

                            <TextBlock Style="{StaticResource Rotulo}" Text="SENHA / ACESSORIOS RECEBIDOS" Margin="0,12,0,0" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SenhaEquipamento, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />
                                <TextBox Grid.Column="2" Text="{Binding Acessorios, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- coluna direita: textos, itens, valores -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                            CornerRadius="8" Padding="18">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Rotulo}" Text="RELATO DO CLIENTE" />
                            <TextBox Text="{Binding Relato, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />

                            <TextBlock Style="{StaticResource Rotulo}" Text="DIAGNOSTICO" Margin="0,12,0,0" />
                            <TextBox Text="{Binding Diagnostico, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />

                            <TextBlock Style="{StaticResource Rotulo}" Text="LAUDO DE CONCLUSAO" Margin="0,12,0,0" />
                            <TextBox Text="{Binding Laudo, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                                     TextWrapping="Wrap" Height="72" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" />
                        </StackPanel>
                    </Border>

                    <Border Background="White" BorderBrush="{StaticResource BrushBorda}" BorderThickness="1"
                            CornerRadius="8" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource Rotulo}" Text="ITENS E PECAS" />
                                <Button Content="Adicionar item" Style="{StaticResource BotaoSecundario}" Padding="12,5"
                                        HorizontalAlignment="Right" FontSize="12" Click="AdicionarItemClicado" />
                            </Grid>

                            <DataGrid ItemsSource="{Binding Itens}" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" RowHeaderWidth="0" Height="220"
                                      Background="White" BorderBrush="#E2E8F0" FontSize="12"
                                      SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Descricao" Binding="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="VerticalAlignment" Value="Center" />
                                                <Setter Property="Margin" Value="6,4" />
                                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}" Width="56" />
                                    <DataGridTextColumn Header="Unit." Binding="{Binding ValorUnitario, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}" Width="80" />
                                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=R$ {0:N2}}" Width="96" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="" Width="40">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#x2715;" Background="Transparent" BorderThickness="0"
                                                        Foreground="#DC3545" Cursor="Hand" FontSize="13"
                                                        Click="RemoverItemClicado" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="ORCAMENTO" />
                                    <TextBox Text="{Binding Orcamento, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="DESCONTO" />
                                    <TextBox Text="{Binding Desconto, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource Rotulo}" Text="GARANTIA (DIAS)" />
                                    <TextBox Text="{Binding Garantia, UpdateSourceTrigger=PropertyChanged}" Padding="8,5" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#F8FAFC" CornerRadius="6" Padding="14,10" Margin="0,14,0,0">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Subtotal" FontSize="12" Foreground="#6B7A8D" />
                                        <TextBlock Text="{Binding Subtotal, StringFormat=R$ {0:N2}}" FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="TOTAL" FontSize="11" Foreground="#6B7A8D" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Total, StringFormat=R$ {0:N2}}" FontSize="20"
                                                   FontWeight="Bold" Foreground="#0F172A" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- rodape -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{Binding Erro}" Foreground="#B02A37" FontSize="12" VerticalAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="520" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Style="{StaticResource BotaoSecundario}" Padding="18,9"
                        Click="FecharClicado" IsCancel="True" />
                <Button Content="Salvar ordem" Style="{StaticResource Botao}" Padding="20,9" Margin="10,0,0,0"
                        Click="SalvarClicado" IsEnabled="{Binding PodeSalvar}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
