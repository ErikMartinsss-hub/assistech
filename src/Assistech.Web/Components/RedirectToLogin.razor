@inject NavigationManager Navigation

@* Durante o prerender estatico nao existe circuito para navegar: chamar
   NavigateTo ali faz o .NET 8 descartar a resposta e devolver corpo vazio
   (tela branca no navegador). OnAfterRenderAsync nao e invocado no
   prerender, entao o redirect so acontece na instancia interativa. *@
<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="spinner-border text-primary" role="status"></div>
</div>

@code {
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return Task.CompletedTask;

        var destino = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo($"/entrar?retorno={Uri.EscapeDataString(destino)}", forceLoad: false, replace: true);
        return Task.CompletedTask;
    }
}
